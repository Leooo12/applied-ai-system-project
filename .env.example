# VibeMatch AI -- environment configuration template.
#
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed -- it holds your secret key.
# This template only documents the variable names; it contains no real secrets.

# REQUIRED. Your Anthropic API key. Get one from https://console.anthropic.com/
# The production AI client reads this and refuses to start if it is missing.
ANTHROPIC_API_KEY=your-api-key-here

# OPTIONAL. Which Claude model to use. Defaults to claude-opus-5 when unset.
VIBEMATCH_MODEL=claude-opus-5

# OPTIONAL. Maximum tokens the model may return per request. Defaults to 1024.
VIBEMATCH_MAX_TOKENS=1024
